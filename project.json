{
  "name": "zpl-imager",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "sourceRoot": ".",
  "projectType": "library",
  "tags": ["shared", "lib"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm test"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/executors/src/publish/npm.mjs"
      },
      "configurations": {
        "patch": { "args": "--release patch" },
        "minor": { "args": "--release minor" },
        "major": { "args": "--release major" },
        "prerelease": { "args": "--release prerelease --type dev" },
        "alpha": { "args": "--release prerelease --type alpha" },
        "beta": { "args": "--release prerelease --type beta" },
        "rc": { "args": "--release prerelease --type rc" }
      }
    }
  }
}
